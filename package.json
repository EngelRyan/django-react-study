{
  "name": "django-react-study",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "frontend": "npm run dev --prefix frontend",
    "backend": "cd backend && python manage.py runserver",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
